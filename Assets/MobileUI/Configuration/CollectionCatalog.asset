  - _id: samguk-standing-buddha
    _eraId: samguk
    _name: "\uAE08\uB3D9\uC5EC\uB798\uC785\uC0C1"
    _spiritName: "\uC815\uB839 \uC774\uB984 \uBBF8\uC815"
