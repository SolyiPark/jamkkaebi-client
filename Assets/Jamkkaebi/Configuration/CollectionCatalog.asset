  - _id: goryeo
    _name: "\uACE0\uB824"
    _period: "\uBD88\uC0C1\uACFC \uACF5\uC608\uC758 \uC804\uC2DC\uC2E4"
    _description: "\uB17C\uC0B0 \uAD00\uCD09\uC0AC \uC11D\uC870\uBBF8\uB975\uBCF4\uC0B4\uC785\uC0C1,
      \uC0C1\uAC10\uCCAD\uC790, \uB098\uC804\uCE60\uAE30\uB97C \uBAA8\uC544 \uACE0\uB824\uC758
      \uC804\uC2DC\uC2E4\uC744 \uC644\uC131\uD574 \uBCF4\uC138\uC694."
    _buildingName: "\uACBD\uCC9C\uC0AC\uC9C0 \uC2ED\uCE35\uC11D\uD0D1"
