  _relics:
  - _id: samguk-standing-buddha
    _eraId: samguk
    _name: "\uAE08\uB3D9\uC5F0\uAC007\uB144\uBA85\uC5EC\uB798\uC785\uC0C1"
    _spiritName: "\uBD88\uAF43\uAC78\uC74C"
    _description: "[\uC784\uC2DC \uC124\uBA85] \uAE08\uB3D9\uC5F0\uAC007\uB144\uBA85\uC5EC\uB798\uC785\uC0C1\uC758
      \uBAA8\uC2B5\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694. \uC720\uBB3C \uD574\uC124\uACFC
      \uB3C4\uAE68\uBE44 \uC774\uC57C\uAE30\uB294 \uCD94\uD6C4 \uCD94\uAC00\uB429\uB2C8\uB2E4."
    _conservationNote: "[\uC784\uC2DC \uBCF5\uC6D0 \uAE30\uB85D] \uAE08\uB3D9\uC5F0\uAC007\uB144\uBA85\uC5EC\uB798\uC785\uC0C1\uC758
      \uBCF5\uC6D0\uC744 \uB9C8\uCCD0 \uB3C4\uAC10\uC5D0 \uB4F1\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBC1C\uAD74\xB7\uBCF4\uC874 \uACFC\uC815\uC758 \uC0C1\uC138 \uC774\uC57C\uAE30\uB294
      \uCD94\uD6C4 \uCD94\uAC00\uB429\uB2C8\uB2E4."
